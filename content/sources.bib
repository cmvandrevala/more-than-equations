@article{BattleshipGame2024,
  title      = {{\emph{Battleship}} (Game)},
  year       = {2024},
  month      = nov,
  journal    = {Wikipedia},
  urldate    = {2025-03-11},
  abstract   = {Battleship (also known as Battleships) is a strategy type guessing game for two players. It is played on ruled grids (paper or board) on which each player's fleet of warships are marked.  The locations of the fleets are concealed from the other player. Players alternate turns calling "shots" at the other player's ships, and the objective of the game is to destroy the opposing player's fleet. Battleship is known worldwide as a pencil and paper game which dates from World War I. It was published by various companies as a pad-and-pencil game in the 1930s and was released as a plastic board game by Milton Bradley in 1967.  The game has spawned electronic versions, video games, smart device apps and a film.},
